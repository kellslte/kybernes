package config

import "os"

{{if .DB -}}
type Config struct {
	Addr        string
	DatabaseURL string
}

func Load() Config {
	return Config{
		Addr:        env("ADDR", ":8080"),
		DatabaseURL: env("DATABASE_URL", "postgres://postgres:postgres@localhost:5432/{{.Name}}?sslmode=disable"),
	}
}
{{- else -}}
type Config struct{ Addr string }

func Load() Config { return Config{Addr: env("ADDR", ":8080")} }
{{- end}}

func env(key, def string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return def
}
