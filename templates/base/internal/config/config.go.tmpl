package config

{{if .DB -}}
import (
	"os"

	"{{.Module}}/internal/database"
)

type Config struct {
	Addr        string
	DatabaseURL string
}

func Load() Config {
	return Config{
		Addr:        env("ADDR", ":8080"),
		DatabaseURL: env("DATABASE_URL", database.DefaultURL),
	}
}
{{- else -}}
import "os"

type Config struct{ Addr string }

func Load() Config { return Config{Addr: env("ADDR", ":8080")} }
{{- end}}

func env(key, def string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return def
}
