// Command migrate runs the embedded SQL migrations with goose.
//
//	go run ./cmd/migrate up|down|status|version|redo|reset
//
// The database comes from DATABASE_URL (see internal/config).
package main

import (
	"context"
	"fmt"
	"os"

	"github.com/pressly/goose/v3"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/database"
	"{{.Module}}/migrations"
)

func main() {
	if len(os.Args) < 2 {
		fmt.Fprintln(os.Stderr, "usage: migrate <up|down|status|version|redo|reset> [args]")
		os.Exit(2)
	}
	if err := run(os.Args[1], os.Args[2:]); err != nil {
		fmt.Fprintln(os.Stderr, "migrate:", err)
		os.Exit(1)
	}
}

func run(command string, args []string) error {
	ctx := context.Background()
	db, err := database.Open(ctx, config.Load().DatabaseURL)
	if err != nil {
		return err
	}
	defer db.Close()
	goose.SetBaseFS(migrations.FS)
	if err := goose.SetDialect("mysql"); err != nil {
		return err
	}
	return goose.RunContext(ctx, command, db, ".", args...)
}
