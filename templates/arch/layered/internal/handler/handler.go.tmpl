// Package handler is the HTTP layer. May import service only.
package handler

import (
	"fmt"
	"net/http"

	"{{.Module}}/internal/service"
)

type Handler struct{ svc *service.Greeting }

func New(s *service.Greeting) *Handler { return &Handler{svc: s} }

func (h *Handler) Health(w http.ResponseWriter, _ *http.Request) {
	_, _ = w.Write([]byte("ok"))
}

func (h *Handler) Hello(w http.ResponseWriter, r *http.Request) {
	fmt.Fprintln(w, h.svc.Greet(r.URL.Query().Get("name")))
}
